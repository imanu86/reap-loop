+    cuda_decode_trace_nvtx_close();
+    cuda_decode_trace_flush();
+    g_cuda_decode_trace.nsys_capture_requested = 0;
+    g_cuda_decode_trace.active.store(0, std::memory_order_relaxed);
+    g_cuda_decode_trace.active_sample_id.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.active_layer.store(
+        UINT32_MAX, std::memory_order_relaxed);
+    if (g_moe_expert_cache.route_worker_safe_leaked.load(
+            std::memory_order_acquire)) {
+        /* The detached route worker may still touch upload trace events.
+         * Quarantine owns them for process lifetime just like its staging. */
+        return;
+    }
+    cuda_decode_trace_destroy_event(&g_cuda_decode_trace.token_start);
+    cuda_decode_trace_destroy_event(&g_cuda_decode_trace.token_end);
+    cuda_decode_trace_destroy_event(&g_cuda_decode_trace.embedding_start);
+    cuda_decode_trace_destroy_event(&g_cuda_decode_trace.embedding_end);
+    cuda_decode_trace_destroy_event(&g_cuda_decode_trace.output_start);
+    cuda_decode_trace_destroy_event(&g_cuda_decode_trace.output_end);
+    for (uint32_t layer = 0; layer < CUDA_MOE_LAYER_COUNT; layer++) {
+        cuda_decode_trace_destroy_event(
+            &g_cuda_decode_trace.layer_start[layer]);
+        cuda_decode_trace_destroy_event(
+            &g_cuda_decode_trace.layer_end[layer]);
+        cuda_decode_trace_destroy_event(
+            &g_cuda_decode_trace.upload_start[layer]);
+        cuda_decode_trace_destroy_event(
+            &g_cuda_decode_trace.upload_end[layer]);
+        g_cuda_decode_trace.upload_started[layer].store(
+            0u, std::memory_order_relaxed);
+        g_cuda_decode_trace.upload_ended[layer].store(
+            0u, std::memory_order_relaxed);
+    }
+    g_cuda_decode_trace.positions.clear();
+    g_cuda_decode_trace.records.clear();
+    g_cuda_decode_trace.record_count = 0u;
+    g_cuda_decode_trace.sample_every = 0u;
+    g_cuda_decode_trace.layer_mask = 0u;
+    if (g_cuda_decode_trace.nsys_domain) {
+        nvtxDomainDestroy(g_cuda_decode_trace.nsys_domain);
+        g_cuda_decode_trace.nsys_domain = NULL;
+    }
+}
+
+static int cuda_decode_trace_create_event(
+        cuda_trace_timing_event *event) {
+    return event &&
+        cudaEventCreateWithFlags(
+            &event->handle, cudaEventDefault) == cudaSuccess;
+}
+
+static int cuda_decode_trace_init(void) {
+    cuda_decode_trace_release();
+    const char *every_value =
+        getenv("DS4_CUDA_DECODE_TRACE_SAMPLE_EVERY");
+    const char *positions_value =
+        getenv("DS4_CUDA_DECODE_TRACE_POSITIONS");
+    const char *layers_value =
+        getenv("DS4_CUDA_DECODE_TRACE_LAYERS");
+    const char *nsys_value =
+        getenv("DS4_CUDA_NSYS_CAPTURE");
+    const char *selftest_value =
+        getenv("DS4_CUDA_DECODE_TRACE_SELFTEST");
+    if (selftest_value && selftest_value[0]) {
+        if (strcmp(selftest_value, "1") != 0 ||
+            !cuda_decode_trace_parser_selftest()) {
+            fprintf(stderr,
+                    "ds4: CUDA decode trace parser selftest failed\n");
+            return 0;
+        }
+    }
+    if ((!every_value || !every_value[0]) &&
+        (!positions_value || !positions_value[0])) {
+        if (nsys_value && nsys_value[0]) {
+            fprintf(stderr,
+                    "ds4: DS4_CUDA_NSYS_CAPTURE requires an explicit "
+                    "decode trace sample/position selector\n");
+            return 0;
+        }
+        return 1;
+    }
+    if (nsys_value && nsys_value[0]) {
+        if (strcmp(nsys_value, "1") != 0) {
+            fprintf(stderr,
+                    "ds4: invalid DS4_CUDA_NSYS_CAPTURE=%s\n",
+                    nsys_value);
+            return 0;
+        }
+        g_cuda_decode_trace.nsys_capture_requested = 1;
+        if (every_value && every_value[0]) {
+            fprintf(stderr,
+                    "ds4: DS4_CUDA_NSYS_CAPTURE requires explicit "
+                    "POSITIONS and forbids SAMPLE_EVERY\n");
+            return 0;
+        }
+    }
+
+    if (every_value && every_value[0]) {
+        char *end = NULL;
+        errno = 0;
+        const unsigned long long every =
+            strtoull(every_value, &end, 10);
+        if (errno != 0 || end == every_value || *end != '\0' ||
+            every == 0u) {
+            fprintf(stderr,
+                    "ds4: invalid "
+                    "DS4_CUDA_DECODE_TRACE_SAMPLE_EVERY=%s\n",
+                    every_value);
+            return 0;
+        }
+        g_cuda_decode_trace.sample_every = (uint64_t)every;
+    }
+    if (positions_value && positions_value[0] &&
+        !cuda_decode_trace_parse_ranges(
+            positions_value, UINT64_MAX,
+            &g_cuda_decode_trace.positions)) {
+        fprintf(stderr,
+                "ds4: invalid DS4_CUDA_DECODE_TRACE_POSITIONS=%s\n",
+                positions_value);
+        cuda_decode_trace_release();
+        return 0;
+    }
+    if (g_cuda_decode_trace.nsys_capture_requested &&
+        !cuda_decode_trace_nsys_positions(
+            g_cuda_decode_trace.positions,
+            &g_cuda_decode_trace.nsys_first_position,
+            &g_cuda_decode_trace.nsys_last_position)) {
+        fprintf(stderr,
+                "ds4: DS4_CUDA_NSYS_CAPTURE requires one or two "
+                "contiguous explicit decode positions\n");
+        cuda_decode_trace_release();
+        return 0;
+    }
+
+    g_cuda_decode_trace.layer_mask =
+        (1ull << CUDA_MOE_LAYER_COUNT) - 1ull;
+    if (layers_value && layers_value[0]) {
+        std::vector<cuda_decode_trace_range> layer_ranges;
+        if (!cuda_decode_trace_parse_ranges(
+                layers_value, CUDA_MOE_LAYER_COUNT - 1u,
+                &layer_ranges)) {
+            fprintf(stderr,
+                    "ds4: invalid DS4_CUDA_DECODE_TRACE_LAYERS=%s\n",
+                    layers_value);
+            cuda_decode_trace_release();
+            return 0;
+        }
+        g_cuda_decode_trace.layer_mask = 0u;
+        for (const cuda_decode_trace_range &range : layer_ranges) {
+            for (uint64_t layer = range.first; layer <= range.last; layer++) {
+                g_cuda_decode_trace.layer_mask |= 1ull << layer;
+            }
+        }
+    }
+
+    if (!cuda_decode_trace_create_event(&g_cuda_decode_trace.token_start) ||
+        !cuda_decode_trace_create_event(&g_cuda_decode_trace.token_end) ||
+        !cuda_decode_trace_create_event(
+            &g_cuda_decode_trace.embedding_start) ||
+        !cuda_decode_trace_create_event(
+            &g_cuda_decode_trace.embedding_end) ||
+        !cuda_decode_trace_create_event(
+            &g_cuda_decode_trace.output_start) ||
+        !cuda_decode_trace_create_event(
+            &g_cuda_decode_trace.output_end)) {
+        fprintf(stderr,
+                "ds4: CUDA decode trace token event allocation failed\n");
+        (void)cudaGetLastError();
+        cuda_decode_trace_release();
+        return 0;
+    }
+    for (uint32_t layer = 0; layer < CUDA_MOE_LAYER_COUNT; layer++) {
+        if (!cuda_decode_trace_create_event(
+                &g_cuda_decode_trace.layer_start[layer]) ||
+            !cuda_decode_trace_create_event(
+                &g_cuda_decode_trace.layer_end[layer]) ||
+            !cuda_decode_trace_create_event(
+                &g_cuda_decode_trace.upload_start[layer]) ||
+            !cuda_decode_trace_create_event(
+                &g_cuda_decode_trace.upload_end[layer])) {
+            fprintf(stderr,
+                    "ds4: CUDA decode trace layer event allocation failed "
+                    "layer=%u\n",
+                    layer);
+            (void)cudaGetLastError();
+            cuda_decode_trace_release();
+            return 0;
+        }
+    }
+    try {
+        g_cuda_decode_trace.records.resize(
+            CUDA_DECODE_TRACE_MAX_RECORDS);
+    } catch (const std::bad_alloc &) {
+        fprintf(stderr,
+                "ds4: CUDA decode trace host record allocation failed\n");
+        cuda_decode_trace_release();
+        return 0;
+    }
+#ifdef _WIN32
+    LARGE_INTEGER frequency;
+    if (!QueryPerformanceFrequency(&frequency) ||
+        frequency.QuadPart <= 0) {
+        fprintf(stderr, "ds4: CUDA decode trace QPC unavailable\n");
+        cuda_decode_trace_release();
+        return 0;
+    }
+    g_cuda_decode_trace.qpc_frequency =
+        (uint64_t)frequency.QuadPart;
+#else
+    g_cuda_decode_trace.qpc_frequency = 1000000000ull;
+#endif
+    if (g_cuda_decode_trace.nsys_capture_requested) {
+        g_cuda_decode_trace.nsys_domain =
+            nvtxDomainCreateA("ds4.cuda");
+        if (!g_cuda_decode_trace.nsys_domain) {
+            fprintf(stderr,
+                    "ds4: CUDA decode trace NVTX domain creation failed\n");
+            cuda_decode_trace_release();
+            return 0;
+        }
+    }
+    g_cuda_decode_trace.active.store(0, std::memory_order_relaxed);
+    g_cuda_decode_trace.active_position.store(0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.active_sample_id.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.active_layer.store(
+        UINT32_MAX, std::memory_order_relaxed);
+    g_cuda_decode_trace.next_sample_id.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.trace_pread_count.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.trace_pread_bytes.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.trace_pread_wait_ticks.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.dropped_records.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.worker_attribution_errors.store(
+        0u, std::memory_order_relaxed);
+    g_cuda_decode_trace.kv_populated.store(
+        0, std::memory_order_relaxed);
+    g_cuda_decode_trace.record_count = 0u;
+    ds4_gpu_decode_trace_enabled = 1;
+    fprintf(stderr,
+            "ds4: [decode-trace-config] enabled=1 sample_every=%llu "
+             "positions=%s layers_mask=0x%011llx timing_events=%u "
+             "hot_path_event_sync=0 nsys_capture=%d\n",
+            (unsigned long long)g_cuda_decode_trace.sample_every,
+             positions_value && positions_value[0] ? positions_value : "none",
+             (unsigned long long)g_cuda_decode_trace.layer_mask,
+             (unsigned)CUDA_DECODE_TRACE_TIMING_EVENT_COUNT,
+             g_cuda_decode_trace.nsys_capture_requested);
+    return 1;
+}
+
+static int cuda_decode_trace_position_selected(uint64_t position) {
+    if (g_cuda_decode_trace.sample_every != 0u &&
+        position % g_cuda_decode_trace.sample_every == 0u) {
+        return 1;
+    }
+    for (const cuda_decode_trace_range &range :
+         g_cuda_decode_trace.positions) {
+        if (position >= range.first && position <= range.last) return 1;
+    }
+    return 0;
+}
+
+static nvtxRangeId_t cuda_decode_trace_nvtx_range(
+        const char *message, uint32_t color) {
+    if (!g_cuda_decode_trace.nsys_domain) return 0;
+    nvtxEventAttributes_t attributes = {};
+    attributes.version = NVTX_VERSION;
+    attributes.size = NVTX_EVENT_ATTRIB_STRUCT_SIZE;
+    attributes.colorType = NVTX_COLOR_ARGB;
+    attributes.color = color;
+    attributes.messageType = NVTX_MESSAGE_TYPE_ASCII;
+    attributes.message.ascii = message;
+    return nvtxDomainRangeStartEx(
+        g_cuda_decode_trace.nsys_domain, &attributes);
+}
+
+extern "C" void ds4_gpu_decode_trace_token_begin(uint64_t position) {
+    if (!ds4_gpu_decode_trace_enabled ||
+        !cuda_decode_trace_position_selected(position)) {
+        return;
+    }
+    if (g_cuda_decode_trace.active.exchange(
+            1, std::memory_order_acq_rel)) {
+        g_cuda_decode_trace.dropped_records.fetch_add(
+            1u, std::memory_order_relaxed);
+        return;
+    }
+    memset(&g_cuda_decode_trace.current, 0,
+           sizeof(g_cuda_decode_trace.current));
+    const uint64_t sample_id =
+        g_cuda_decode_trace.next_sample_id.fetch_add(
+            1u, std::memory_order_relaxed) + 1u;
+    g_cuda_decode_trace.current.sample_id = sample_id;
+    g_cuda_decode_trace.current.position = position;
+    g_cuda_decode_trace.current.host_started_qpc =
+        cuda_decode_trace_qpc_now_raw();
+    g_cuda_decode_trace.current.pread_count_begin =
+        g_cuda_decode_trace.trace_pread_count.load(
+            std::memory_order_acquire);
+    g_cuda_decode_trace.current.pread_bytes_begin =
+        g_cuda_decode_trace.trace_pread_bytes.load(
+            std::memory_order_acquire);
+    g_cuda_decode_trace.current.pread_wait_ticks_begin =
+        g_cuda_decode_trace.trace_pread_wait_ticks.load(
+            std::memory_order_acquire);
+    g_cuda_decode_trace.active_position.store(
+        position, std::memory_order_release);
+    g_cuda_decode_trace.active_layer.store(
+        UINT32_MAX, std::memory_order_release);
+    memset(g_cuda_decode_trace.layer_started, 0,
+           sizeof(g_cuda_decode_trace.layer_started));
+    memset(g_cuda_decode_trace.layer_ended, 0,
+           sizeof(g_cuda_decode_trace.layer_ended));
+    for (uint32_t layer = 0; layer < CUDA_MOE_LAYER_COUNT; layer++) {
+        g_cuda_decode_trace.upload_started[layer].store(
+            0u, std::memory_order_relaxed);
+        g_cuda_decode_trace.upload_ended[layer].store(
+            0u, std::memory_order_relaxed);
+    }
+    g_cuda_decode_trace.embedding_started = 0u;
+    g_cuda_decode_trace.embedding_ended = 0u;
+    g_cuda_decode_trace.output_started = 0u;
+    g_cuda_decode_trace.output_ended = 0u;
+    if (g_cuda_decode_trace.nsys_capture_requested &&
+        position == g_cuda_decode_trace.nsys_first_position &&
+        g_cuda_decode_trace.kv_populated.load(
+            std::memory_order_acquire)) {
+        g_cuda_decode_trace.nsys_capture_range =
+            cuda_decode_trace_nvtx_range(
+                "ds4.decode.capture", 0xff00a0ffu);
+        g_cuda_decode_trace.nsys_capture_active =
+            g_cuda_decode_trace.nsys_capture_range != 0;
+    }
+    if (g_cuda_decode_trace.nsys_capture_active) {
+        g_cuda_decode_trace.nsys_token_range =
+            cuda_decode_trace_nvtx_range(
+                "ds4.decode.token", 0xff00ff80u);
+    }
+    g_cuda_decode_trace.active_sample_id.store(
+        sample_id, std::memory_order_release);
+    if (cudaEventRecord(
+            g_cuda_decode_trace.token_start.handle, 0) != cudaSuccess) {
+        (void)cudaGetLastError();
+        g_cuda_decode_trace.dropped_records.fetch_add(
+            1u, std::memory_order_relaxed);
+        g_cuda_decode_trace.active_sample_id.store(
+            0u, std::memory_order_release);
+        g_cuda_decode_trace.active.store(0, std::memory_order_release);
+    }
+}
+
+extern "C" void ds4_gpu_decode_trace_layer_begin(
+        uint32_t layer, uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position ||
+        layer >= CUDA_MOE_LAYER_COUNT ||
+        (g_cuda_decode_trace.layer_mask & (1ull << layer)) == 0u) {
+        return;
+    }
+    cuda_decode_trace_layer_record &record =
+        g_cuda_decode_trace.current.layer[layer];
+    record.selected = 1u;
+    record.sample_id_match = 1u;
+    record.host_started_qpc = cuda_decode_trace_qpc_now_raw();
+    g_cuda_decode_trace.active_layer.store(
+        layer, std::memory_order_release);
+    if (g_cuda_decode_trace.nsys_capture_active) {
+        g_cuda_decode_trace.nsys_layer_range[layer] =
+            cuda_decode_trace_nvtx_range(
+                "ds4.decode.layer", 0xffffa000u);
+    }
+    if (cudaEventRecord(
+            g_cuda_decode_trace.layer_start[layer].handle,
+            0) == cudaSuccess) {
+        g_cuda_decode_trace.layer_started[layer] = 1u;
+    } else {
+        (void)cudaGetLastError();
+    }
+}
+
+extern "C" void ds4_gpu_decode_trace_layer_end(
+        uint32_t layer, uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position ||
+        layer >= CUDA_MOE_LAYER_COUNT ||
+        !g_cuda_decode_trace.layer_started[layer]) {
+        return;
+    }
+    g_cuda_decode_trace.current.layer[layer].host_ended_qpc =
+        cuda_decode_trace_qpc_now_raw();
+    if (cudaEventRecord(
+            g_cuda_decode_trace.layer_end[layer].handle,
+            0) == cudaSuccess) {
+        g_cuda_decode_trace.layer_ended[layer] = 1u;
+    } else {
+        (void)cudaGetLastError();
+    }
+    if (g_cuda_decode_trace.nsys_layer_range[layer] &&
+        g_cuda_decode_trace.nsys_domain) {
+        nvtxDomainRangeEnd(
+            g_cuda_decode_trace.nsys_domain,
+            g_cuda_decode_trace.nsys_layer_range[layer]);
+        g_cuda_decode_trace.nsys_layer_range[layer] = 0;
+    }
+    g_cuda_decode_trace.active_layer.store(
+        UINT32_MAX, std::memory_order_release);
+}
+
+extern "C" void ds4_gpu_decode_trace_output_begin(
+        uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position) {
+        return;
+    }
+    g_cuda_decode_trace.current.output_submit_started_qpc =
+        cuda_decode_trace_qpc_now_raw();
+    if (cudaEventRecord(
+            g_cuda_decode_trace.output_start.handle,
+            0) == cudaSuccess) {
+        g_cuda_decode_trace.output_started = 1u;
+    } else {
+        (void)cudaGetLastError();
+    }
+}
+
+extern "C" void ds4_gpu_decode_trace_output_end(
+        uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position ||
+        !g_cuda_decode_trace.output_started) {
+        return;
+    }
+    const uint64_t now = cuda_decode_trace_qpc_now_raw();
+    g_cuda_decode_trace.current.output_submit_ticks +=
+        now - g_cuda_decode_trace.current.output_submit_started_qpc;
+    if (cudaEventRecord(
+            g_cuda_decode_trace.output_end.handle,
+            0) == cudaSuccess) {
+        g_cuda_decode_trace.output_ended = 1u;
+    } else {
+        (void)cudaGetLastError();
+    }
+}
+
+extern "C" void ds4_gpu_decode_trace_split_sync_begin(
+        uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position) {
+        return;
+    }
+    g_cuda_decode_trace.current.split_sync_started_qpc =
+        cuda_decode_trace_qpc_now_raw();
+}
+
+extern "C" void ds4_gpu_decode_trace_split_sync_end(
+        uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position ||
+        !g_cuda_decode_trace.current.split_sync_started_qpc) {
+        return;
+    }
+    g_cuda_decode_trace.current.split_sync_ticks +=
+        cuda_decode_trace_qpc_now_raw() -
+        g_cuda_decode_trace.current.split_sync_started_qpc;
+    g_cuda_decode_trace.current.split_sync_count++;
+    g_cuda_decode_trace.current.split_sync_started_qpc = 0u;
+}
+
+extern "C" void ds4_gpu_decode_trace_token_encoded(uint64_t position) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position) {
+        return;
+    }
+    g_cuda_decode_trace.current.end_sync_started_qpc =
+        cuda_decode_trace_qpc_now_raw();
+    if (cudaEventRecord(
+            g_cuda_decode_trace.token_end.handle,
+            0) == cudaSuccess) {
+        g_cuda_decode_trace.current.token_event_recorded = 1u;
+    } else {
+        (void)cudaGetLastError();
+    }
+}
+
+static int cuda_decode_trace_elapsed(
+        const cuda_trace_timing_event &start,
+        const cuda_trace_timing_event &end,
+        float *milliseconds) {
+    if (!start.handle || !end.handle || !milliseconds) return 0;
+    return cudaEventElapsedTime(
+        milliseconds, start.handle, end.handle) == cudaSuccess;
+}
+
+extern "C" void ds4_gpu_decode_trace_sync_complete(
+        uint64_t position, int success) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position) {
+        return;
+    }
+    const uint64_t now = cuda_decode_trace_qpc_now_raw();
+    if (g_cuda_decode_trace.current.end_sync_started_qpc) {
+        g_cuda_decode_trace.current.end_sync_ticks =
+            now - g_cuda_decode_trace.current.end_sync_started_qpc;
+    }
+    if (!success || !g_cuda_decode_trace.current.token_event_recorded) {
+        return;
+    }
+    cuda_decode_trace_record &record = g_cuda_decode_trace.current;
+    record.gpu_default_valid = cuda_decode_trace_elapsed(
+        g_cuda_decode_trace.token_start,
+        g_cuda_decode_trace.token_end,
+        &record.gpu_default_window_ms) ? 1u : 0u;
+    if (g_cuda_decode_trace.embedding_started &&
+        g_cuda_decode_trace.embedding_ended) {
+        record.embedding_gpu_valid = cuda_decode_trace_elapsed(
+            g_cuda_decode_trace.embedding_start,
+            g_cuda_decode_trace.embedding_end,
+            &record.embedding_gpu_window_ms) ? 1u : 0u;
+    }
+    if (g_cuda_decode_trace.output_started &&
+        g_cuda_decode_trace.output_ended) {
