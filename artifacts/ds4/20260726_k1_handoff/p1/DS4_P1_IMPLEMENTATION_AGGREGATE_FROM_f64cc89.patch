+static double cuda_decode_trace_ticks_ms(uint64_t ticks) {
+    return g_cuda_decode_trace.qpc_frequency
+        ? (double)ticks * 1000.0 /
+            (double)g_cuda_decode_trace.qpc_frequency
+        : 0.0;
+}
