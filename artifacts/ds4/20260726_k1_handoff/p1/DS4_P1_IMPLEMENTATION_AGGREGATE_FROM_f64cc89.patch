+static void cuda_decode_trace_nvtx_close(void) {
+    if (g_cuda_decode_trace.nsys_token_range && g_cuda_decode_trace.nsys_domain) {
+        nvtxDomainRangeEnd(
+            g_cuda_decode_trace.nsys_domain,
+            g_cuda_decode_trace.nsys_token_range);
+        g_cuda_decode_trace.nsys_token_range = 0;
+    }
+    for (uint32_t layer = 0; layer < CUDA_MOE_LAYER_COUNT; layer++) {
+        if (g_cuda_decode_trace.nsys_layer_range[layer] &&
+            g_cuda_decode_trace.nsys_domain) {
+            nvtxDomainRangeEnd(
+                g_cuda_decode_trace.nsys_domain,
+                g_cuda_decode_trace.nsys_layer_range[layer]);
+            g_cuda_decode_trace.nsys_layer_range[layer] = 0;
+        }
+    }
+    if (g_cuda_decode_trace.nsys_capture_range &&
+        g_cuda_decode_trace.nsys_domain) {
+        nvtxDomainRangeEnd(
+            g_cuda_decode_trace.nsys_domain,
+            g_cuda_decode_trace.nsys_capture_range);
+        g_cuda_decode_trace.nsys_capture_range = 0;
+    }
+    g_cuda_decode_trace.nsys_capture_active = 0;
+}
