+static int cuda_decode_trace_parse_ranges(
+        const char *value,
+        uint64_t maximum,
+        std::vector<cuda_decode_trace_range> *ranges) {
+    if (!value || !value[0] || !ranges) return 0;
+    const char *cursor = value;
+    while (*cursor) {
+        while (*cursor == ' ' || *cursor == '\t' || *cursor == ',') cursor++;
+        if (!*cursor) break;
+        char *end = NULL;
+        errno = 0;
+        const unsigned long long first = strtoull(cursor, &end, 10);
+        if (errno != 0 || end == cursor || first > maximum) return 0;
+        uint64_t last = (uint64_t)first;
+        cursor = end;
+        if (*cursor == '-') {
+            cursor++;
+            errno = 0;
+            const unsigned long long parsed_last =
+                strtoull(cursor, &end, 10);
+            if (errno != 0 || end == cursor || parsed_last > maximum ||
+                parsed_last < first) {
+                return 0;
+            }
+            last = (uint64_t)parsed_last;
+            cursor = end;
+        }
+        while (*cursor == ' ' || *cursor == '\t') cursor++;
+        if (*cursor && *cursor != ',') return 0;
+        ranges->push_back(cuda_decode_trace_range{
+            (uint64_t)first, last});
+        if (*cursor == ',') cursor++;
+    }
+    return !ranges->empty();
+}
+
+static int cuda_decode_trace_nsys_positions(
+        const std::vector<cuda_decode_trace_range> &ranges,
+        uint64_t *first_out, uint64_t *last_out) {
+    uint64_t values[2] = {0u, 0u};
+    uint32_t count = 0u;
+    for (const cuda_decode_trace_range &range : ranges) {
+        if (range.last - range.first > 1u) return 0;
+        for (uint64_t value = range.first; value <= range.last; value++) {
+            if (count >= 2u ||
+                (count != 0u && value != values[count - 1u] + 1u)) {
+                return 0;
+            }
+            values[count++] = value;
+            if (value == UINT64_MAX) break;
+        }
+    }
+    if (count == 0u) return 0;
+    if (first_out) *first_out = values[0];
+    if (last_out) *last_out = values[count - 1u];
+    return 1;
+}
+
+static int cuda_decode_trace_parser_selftest(void) {
+    struct parser_case {
+        const char *value;
+        uint64_t maximum;
+        int expected;
+    };
+    static const parser_case cases[] = {
+        {"0", 42u, 1},
+        {"0,4,20,42", 42u, 1},
+        {"13-14", UINT64_MAX, 1},
+        {"", 42u, 0},
+        {"-1", 42u, 0},
+        {"4-3", 42u, 0},
+        {"43", 42u, 0},
+        {"1x", 42u, 0},
+    };
+    for (const parser_case &test : cases) {
+        std::vector<cuda_decode_trace_range> parsed;
+        if (cuda_decode_trace_parse_ranges(
+                test.value, test.maximum, &parsed) != test.expected) {
+            return 0;
+        }
+    }
+    std::vector<cuda_decode_trace_range> one;
+    std::vector<cuda_decode_trace_range> two;
+    std::vector<cuda_decode_trace_range> three;
+    if (!cuda_decode_trace_parse_ranges("100", UINT64_MAX, &one) ||
+        !cuda_decode_trace_parse_ranges("100-101", UINT64_MAX, &two) ||
+        !cuda_decode_trace_parse_ranges("100-102", UINT64_MAX, &three) ||
+        !cuda_decode_trace_nsys_positions(one, NULL, NULL) ||
+        !cuda_decode_trace_nsys_positions(two, NULL, NULL) ||
+        cuda_decode_trace_nsys_positions(three, NULL, NULL)) {
+        return 0;
+    }
+    return 1;
+}
