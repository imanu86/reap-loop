+static int cuda_moe_route_publish_batch_append(
+        cuda_moe_route_publish_batch *batch,
+        int32_t old_map_index,
+        uint32_t new_map_index,
+        uint32_t cache_slot,
+        uint32_t route,
+        uint32_t transient_slot,
+        uint32_t resident) {
+    if (!batch || batch->count >= CUDA_MOE_ROUTE_COUNT ||
+        route >= CUDA_MOE_ROUTE_COUNT) {
+        return 0;
+    }
+    cuda_moe_route_publish_entry &entry = batch->entries[batch->count++];
+    entry.old_map_index = old_map_index;
+    entry.new_map_index = new_map_index;
+    entry.cache_slot = cache_slot;
+    entry.route = route;
+    entry.transient_slot = transient_slot;
+    entry.resident = resident ? 1u : 0u;
+    return 1;
+}
+
+static int cuda_moe_route_publish_batch_flush(
+        cuda_moe_expert_cache *cache,
+        const cuda_moe_route_request &request,
+        cuda_moe_route_publish_batch *batch) {
+    if (!cache || !batch || request.route_count == 0u ||
+        request.route_count > CUDA_MOE_ROUTE_COUNT) {
+        return 0;
+    }
+    if (batch->count == 0u) return 1;
+    const uint32_t route_count = batch->count;
+    moe_publish_route_batch_kernel<<<
+            1, 1, 0, cache->route_upload_stream>>>(
+        cache->device_slot_by_layer_expert,
+        cache->device_route_ptrs,
+        *batch,
+        request.route_count,
+        cache->gate,
+        cache->up,
+        cache->down,
+        cache->route_transient_gate,
+        cache->route_transient_up,
+        cache->route_transient_down,
+        cache->gate_expert_bytes,
+        cache->down_expert_bytes);
+    const cudaError_t publish_error = cudaGetLastError();
+    if (publish_error != cudaSuccess) {
+        (void)cudaGetLastError();
+        return 0;
+    }
+    cache->batched_publish_kernels++;
+    cache->batched_publish_routes += route_count;
+    cuda_decode_trace_note_publish(
+        request, 1u, route_count);
+    batch->count = 0u;
+    return 1;
+}
