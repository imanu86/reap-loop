diff --git a/tests/test_p2c_nsys_capture_static.ps1 b/tests/test_p2c_nsys_capture_static.ps1
new file mode 100644
index 0000000..2c1b045
--- /dev/null
+++ b/tests/test_p2c_nsys_capture_static.ps1
@@ -0,0 +1,69 @@
+$ErrorActionPreference = 'Stop'
+
+$root = Split-Path -Parent $PSScriptRoot
+$cuda = [System.IO.File]::ReadAllText((Join-Path $root 'ds4_cuda.cu'))
+
+function Assert-True([bool]$Condition, [string]$Message) {
+    if (-not $Condition) {
+        throw "P2-C NVTX capture static contract failed: $Message"
+    }
+}
+
+function Slice-TextBetween(
+        [string]$Text, [string]$Start, [string]$End) {
+    $startIndex = $Text.IndexOf($Start, [StringComparison]::Ordinal)
+    Assert-True ($startIndex -ge 0) "missing start marker: $Start"
+    $endIndex = $Text.IndexOf(
+        $End, $startIndex + $Start.Length, [StringComparison]::Ordinal)
+    Assert-True ($endIndex -gt $startIndex) "missing end marker: $End"
+    return $Text.Substring($startIndex, $endIndex - $startIndex)
+}
+
+$beforeProcesses = @(Get-Process -Name 'ds4_server' -ErrorAction SilentlyContinue |
+    Select-Object -ExpandProperty Id)
+
+Assert-True ($cuda.Contains('#include <nvtx3/nvToolsExt.h>')) `
+    'NVTX3 header is missing'
+Assert-True (-not $cuda.Contains('cudaProfilerStart(') -and
+             -not $cuda.Contains('cudaProfilerStop(')) `
+    'cudaProfilerApi arming must be replaced by NVTX capture ranges'
+
+$trace = Slice-TextBetween $cuda `
+    'struct cuda_decode_trace_range {' `
+    'static cuda_moe_expert_cache *cuda_moe_expert_cache_prepare('
+Assert-True ($trace.Contains('DS4_CUDA_NSYS_CAPTURE') -and
+             $trace.Contains(
+                 'strcmp(nsys_value, "1") != 0')) `
+    'strict Nsight opt-in is missing'
+Assert-True ($trace.Contains(
+                 'forbids SAMPLE_EVERY') -and
+             $trace.Contains(
+                 'requires one or two') -and
+             $trace.Contains(
+                 'cuda_decode_trace_nsys_positions(')) `
+    'Nsight must accept only one/two contiguous explicit positions'
+Assert-True ($trace.Contains('nvtxDomainCreateA("ds4.cuda")') -and
+             $trace.Contains('"ds4.decode.capture"') -and
+             $trace.Contains('"ds4.decode.token"') -and
+             $trace.Contains('"ds4.decode.layer"')) `
+    'NVTX domain and bounded capture/token/layer ranges are incomplete'
+Assert-True ($trace.Contains(
+                 'g_cuda_decode_trace.kv_populated.load(') -and
+             $cuda.Contains(
+                 'g_cuda_decode_trace.kv_populated.store(')) `
+    'capture must arm only after the post-prefill KV lifecycle edge'
+Assert-True ($trace.Contains('nvtxDomainRangeStartEx(') -and
+             $trace.Contains('nvtxDomainRangeEnd(') -and
+             $trace.Contains('cuda_decode_trace_nvtx_close();')) `
+    'NVTX start/end/cleanup paths are incomplete'
+Assert-True (-not $trace.Contains('cudaEventSynchronize(') -and
+             -not $trace.Contains('cudaDeviceSynchronize(') -and
+             -not $trace.Contains('cudaStreamSynchronize(')) `
+    'NVTX arming must not add a CUDA drain'
+
+$afterProcesses = @(Get-Process -Name 'ds4_server' -ErrorAction SilentlyContinue |
+    Select-Object -ExpandProperty Id)
+Assert-True (($beforeProcesses -join ',') -eq ($afterProcesses -join ',')) `
+    'static test changed DS4 process state'
+
+Write-Host 'test_p2c_nsys_capture_static.ps1: PASS'
