+static int cuda_g73_copy_selected_from_route_mailbox(
+        cuda_moe_expert_cache *cache,
+        uint32_t expected_sequence,
+        uint32_t expected_layer,
+        uint64_t expected_gate_offset,
+        uint32_t expected_route_count,
+        double absolute_deadline,
+        int32_t *out_selected) {
+    if (!cache || !cache->g73_host_selected_requested ||
+        !cache->route_request_host || expected_sequence == 0u ||
+        expected_route_count == 0u ||
+        expected_route_count > CUDA_MOE_ROUTE_COUNT || !out_selected) {
+        return 0;
+    }
+
+    const double wait_started = cuda_wall_sec();
+    const double wait_deadline =
+        absolute_deadline > 0.0 ? absolute_deadline : wait_started + 0.25;
+    const uint64_t expected_generation =
+        cache->route_submitted_generation.load(std::memory_order_acquire);
+    if (expected_generation == 0u ||
+        cache->route_submitted_sequence.load(std::memory_order_acquire) !=
+            expected_sequence) {
+        cache->g73_host_selected_fallbacks++;
+        return 0;
+    }
+
+    while (*(volatile uint32_t *)&cache->route_request_host->sequence !=
+           expected_sequence) {
+        if (cache->route_stop.load(std::memory_order_acquire) ||
+            cache->route_worker_failed.load(std::memory_order_acquire) ||
+            cuda_wall_sec() >= wait_deadline) {
+            cache->g73_host_selected_fallbacks++;
+            return 0;
+        }
+#ifdef _WIN32
+        (void)SwitchToThread();
+#else
+        usleep(0);
+#endif
+    }
+#ifdef _WIN32
+    MemoryBarrier();
+#else
+    __sync_synchronize();
+#endif
+
+    cuda_moe_route_request request;
+    memcpy(&request, cache->route_request_host, sizeof(request));
+    if (request.sequence != expected_sequence ||
+        request.host_generation != expected_generation ||
+        request.layer_index != expected_layer ||
+        request.gate_offset != expected_gate_offset ||
+        request.route_count != expected_route_count) {
+        cache->g73_host_selected_fallbacks++;
+        return 0;
+    }
+    for (uint32_t route = 0; route < expected_route_count; route++) {
+        if (request.selected[route] < 0 ||
+            (uint32_t)request.selected[route] >= 256u) {
+            cache->g73_host_selected_fallbacks++;
+            return 0;
+        }
+    }
+
+    memcpy(out_selected, request.selected,
+           (size_t)expected_route_count * sizeof(out_selected[0]));
+    cache->g73_host_selected_reuse++;
+    cache->g73_host_selected_wait_seconds +=
+        cuda_wall_sec() - wait_started;
+    return 1;
+}
