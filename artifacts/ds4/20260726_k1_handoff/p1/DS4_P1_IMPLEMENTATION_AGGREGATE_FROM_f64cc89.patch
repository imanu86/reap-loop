+extern "C" void ds4_gpu_decode_trace_token_end(
+        uint64_t position, int success) {
+    if (!g_cuda_decode_trace.active.load(std::memory_order_acquire) ||
+        g_cuda_decode_trace.active_position.load(
+            std::memory_order_acquire) != position) {
+        return;
+    }
+    cuda_decode_trace_record &record = g_cuda_decode_trace.current;
+    record.host_ended_qpc = cuda_decode_trace_qpc_now_raw();
+    record.success = success ? 1u : 0u;
+    const uint64_t pread_count_end =
+        g_cuda_decode_trace.trace_pread_count.load(
+            std::memory_order_acquire);
+    const uint64_t pread_bytes_end =
+        g_cuda_decode_trace.trace_pread_bytes.load(
+            std::memory_order_acquire);
+    const uint64_t pread_wait_end =
+        g_cuda_decode_trace.trace_pread_wait_ticks.load(
+            std::memory_order_acquire);
+    if (pread_count_end >= record.pread_count_begin &&
+        pread_bytes_end >= record.pread_bytes_begin &&
+        pread_wait_end >= record.pread_wait_ticks_begin) {
+        record.pread_count =
+            pread_count_end - record.pread_count_begin;
+        record.pread_bytes =
+            pread_bytes_end - record.pread_bytes_begin;
+        record.pread_wait_ticks =
+            pread_wait_end - record.pread_wait_ticks_begin;
+        record.io_counter_valid = 1u;
+    }
+    record.record_complete =
+        success && record.elapsed_resolved &&
+        record.io_counter_valid ? 1u : 0u;
+    if (g_cuda_decode_trace.record_count <
+        g_cuda_decode_trace.records.size()) {
+        g_cuda_decode_trace.records[
+            g_cuda_decode_trace.record_count++] = record;
+    } else {
+        g_cuda_decode_trace.dropped_records.fetch_add(
+            1u, std::memory_order_relaxed);
+    }
+    if (g_cuda_decode_trace.nsys_token_range &&
+        g_cuda_decode_trace.nsys_domain) {
+        nvtxDomainRangeEnd(
+            g_cuda_decode_trace.nsys_domain,
+            g_cuda_decode_trace.nsys_token_range);
+        g_cuda_decode_trace.nsys_token_range = 0;
+    }
+    if (g_cuda_decode_trace.nsys_capture_active &&
+        (position >= g_cuda_decode_trace.nsys_last_position ||
+         !success)) {
+        cuda_decode_trace_nvtx_close();
+    }
+    g_cuda_decode_trace.active_layer.store(
+        UINT32_MAX, std::memory_order_release);
+    g_cuda_decode_trace.active_sample_id.store(
+        0u, std::memory_order_release);
+    g_cuda_decode_trace.active.store(0, std::memory_order_release);
+}
