+static int cuda_moe_route_mailbox_worker_claim(
+        cuda_moe_expert_cache *cache,
+        uint32_t sequence,
+        uint64_t generation) {
+    if (!cache || generation == 0u) return 0;
+
+    if (generation > 1u) {
+        const uint64_t prior_generation = generation - 1u;
+        cuda_moe_route_mailbox_slot &prior =
+            cache->route_mailbox[prior_generation & 1u];
+        const uint64_t recorded_generation =
+            cache->route_consumer_event_generation.load(
+                std::memory_order_acquire);
+        const uint64_t prior_slot_generation =
+            prior.generation.load(std::memory_order_acquire);
+        const cudaError_t event_status =
+            cache->route_consumer_done_event
+                ? cudaEventQuery(cache->route_consumer_done_event)
+                : cudaErrorInvalidResourceHandle;
+        if (recorded_generation != prior_generation ||
+            prior_slot_generation != prior_generation ||
+            event_status != cudaSuccess) {
+            if (event_status != cudaSuccess &&
+                event_status != cudaErrorNotReady) {
+                (void)cudaGetLastError();
+            }
+            return cuda_moe_route_mailbox_fail_closed(
+                cache, sequence, generation,
+                recorded_generation != prior_generation
+                    ? "consumer-event-generation"
+                    : (prior_slot_generation != prior_generation
+                        ? "prior-slot-generation"
+                        : "consumer-event-incomplete"));
+        }
+        uint32_t prior_state = CUDA_MOE_ROUTE_MAILBOX_UPLOAD_ENQUEUED;
+        if (!prior.state.compare_exchange_strong(
+                prior_state, CUDA_MOE_ROUTE_MAILBOX_CONSUMER_DONE,
+                std::memory_order_acq_rel, std::memory_order_acquire)) {
+            return cuda_moe_route_mailbox_fail_closed(
+                cache, sequence, generation, "prior-slot-state");
+        }
+        cache->route_consumer_done_generation.store(
+            prior_generation, std::memory_order_release);
+    }
+
+    cuda_moe_route_mailbox_slot &current =
+        cache->route_mailbox[generation & 1u];
+    if (current.generation.load(std::memory_order_acquire) != generation) {
+        return cuda_moe_route_mailbox_fail_closed(
+            cache, sequence, generation, "current-slot-generation");
+    }
+    uint32_t state = CUDA_MOE_ROUTE_MAILBOX_GPU_WRITING;
+    if (!current.state.compare_exchange_strong(
+            state, CUDA_MOE_ROUTE_MAILBOX_WORKER_OWNS,
+            std::memory_order_acq_rel, std::memory_order_acquire)) {
+        return cuda_moe_route_mailbox_fail_closed(
+            cache, sequence, generation, "current-slot-state");
+    }
+    cache->route_consumed_sequence.store(
+        sequence, std::memory_order_release);
+    cache->route_consumed_generation.store(
+        generation, std::memory_order_release);
+    return 1;
+}
