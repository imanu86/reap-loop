+        std::memory_order_acquire);
+    if (layer >= CUDA_MOE_LAYER_COUNT ||
+        (g_cuda_decode_trace.layer_mask & (1ull << layer)) == 0u) {
+        return NULL;
+    }
+    return &g_cuda_decode_trace.current.layer[layer];
