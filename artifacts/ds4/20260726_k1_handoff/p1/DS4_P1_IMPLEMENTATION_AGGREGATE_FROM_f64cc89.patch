+                std::memory_order_acquire) &&
+            g_cuda_decode_trace.upload_ended[layer].load(
+                std::memory_order_acquire)) {
+            item.upload_gpu_valid = cuda_decode_trace_elapsed(
+                g_cuda_decode_trace.upload_start[layer],
+                g_cuda_decode_trace.upload_end[layer],
+                &item.upload_gpu_window_ms) ? 1u : 0u;
