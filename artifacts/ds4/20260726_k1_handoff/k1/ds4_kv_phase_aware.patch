+extern "C" int ds4_gpu_kv_staged_request_begin(
+        uint64_t session_generation,
+        uint64_t checkpoint_generation,
+        uint64_t checkpoint_fingerprint,
+        uint32_t checkpoint_tokens,
+        uint32_t suffix_tokens,
+        int exact_prefix,
