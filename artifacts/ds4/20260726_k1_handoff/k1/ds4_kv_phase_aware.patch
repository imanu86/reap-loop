+static uint64_t cuda_kv_meta_live_bytes(const cuda_kv_tensor_meta *meta) {
+    if (!meta) return 0;
+    uint64_t bytes = 0;
+    for (uint32_t i = 0; i < meta->live_count; i++) {
+        bytes += meta->live[i].bytes;
+    }
+    return bytes;
+}
+
+static int cuda_kv_meta_set_live_ranges(
+        cuda_kv_tensor_meta *meta,
+        uint64_t capacity,
+        uint64_t offset0,
+        uint64_t bytes0,
+        uint64_t offset1,
+        uint64_t bytes1) {
+    if (!meta) return 0;
+    cuda_kv_live_range input[2] = {
+        {offset0, bytes0},
+        {offset1, bytes1}
+    };
+    cuda_kv_live_range compact[2] = {};
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < 2; i++) {
+        if (input[i].bytes == 0) continue;
+        if (input[i].offset > capacity ||
+            input[i].bytes > capacity - input[i].offset) {
+            return 0;
+        }
+        compact[count++] = input[i];
+    }
+    if (count == 2 && compact[1].offset < compact[0].offset) {
+        std::swap(compact[0], compact[1]);
+    }
+    if (count == 2) {
+        const uint64_t first_end =
+            compact[0].offset + compact[0].bytes;
+        if (compact[1].offset <= first_end) {
+            const uint64_t second_end =
+                compact[1].offset + compact[1].bytes;
+            if (second_end > first_end) {
+                compact[0].bytes = second_end - compact[0].offset;
+            }
+            count = 1;
+        }
+    }
+    meta->live[0] = count > 0 ? compact[0] : cuda_kv_live_range{0, 0};
+    meta->live[1] = count > 1 ? compact[1] : cuda_kv_live_range{0, 0};
+    meta->live_count = count;
+    return 1;
+}
+
+static int cuda_kv_meta_contains(
+        const cuda_kv_tensor_meta *meta,
+        uint64_t offset,
+        uint64_t bytes) {
+    if (!meta) return 0;
+    if (bytes == 0) return 1;
+    if (offset > UINT64_MAX - bytes) return 0;
+    const uint64_t end = offset + bytes;
+    for (uint32_t i = 0; i < meta->live_count; i++) {
+        const uint64_t live_end =
+            meta->live[i].offset + meta->live[i].bytes;
+        if (offset >= meta->live[i].offset && end <= live_end) return 1;
+    }
+    return 0;
+}
+
+static int cuda_kv_tensor_contains_live(
+        const ds4_gpu_tensor *tensor,
+        uint64_t offset,
+        uint64_t bytes) {
+    if (!tensor || !tensor->kv_meta ||
+        offset > tensor->bytes || bytes > tensor->bytes - offset ||
+        tensor->kv_meta_offset > UINT64_MAX - offset) {
+        return 0;
+    }
+    return cuda_kv_meta_contains(
+        tensor->kv_meta, tensor->kv_meta_offset + offset, bytes);
+}
+
+static int cuda_kv_meta_add_live_range(
+        cuda_kv_tensor_meta *meta,
+        uint64_t capacity,
+        uint64_t offset,
+        uint64_t bytes) {
+    if (!meta || offset > capacity || bytes > capacity - offset) return 0;
+    if (bytes == 0 || cuda_kv_meta_contains(meta, offset, bytes)) return 1;
+    cuda_kv_live_range ranges[3] = {};
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < meta->live_count; i++) {
+        ranges[count++] = meta->live[i];
+    }
+    ranges[count++] = {offset, bytes};
+    std::sort(ranges, ranges + count,
+              [](const cuda_kv_live_range &a,
+                 const cuda_kv_live_range &b) {
+                    return a.offset < b.offset;
+              });
+    cuda_kv_live_range merged[3] = {};
+    uint32_t merged_count = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        if (merged_count == 0) {
+            merged[merged_count++] = ranges[i];
+            continue;
+        }
+        cuda_kv_live_range &last = merged[merged_count - 1u];
+        const uint64_t last_end = last.offset + last.bytes;
+        if (ranges[i].offset <= last_end) {
+            const uint64_t range_end = ranges[i].offset + ranges[i].bytes;
+            if (range_end > last_end) last.bytes = range_end - last.offset;
+        } else {
+            merged[merged_count++] = ranges[i];
+        }
+    }
+    if (merged_count > 2) return 0;
+    meta->live[0] = merged[0];
+    meta->live[1] = merged_count > 1
+        ? merged[1] : cuda_kv_live_range{0, 0};
+    meta->live_count = merged_count;
+    return 1;
+}
