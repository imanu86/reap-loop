+static int cuda_kv_staged_validate_registry_locked(
+        uint64_t generation,
+        int require_marked) {
+    cuda_kv_staged_registry &state = g_kv_staged_registry;
+    if (state.tensors.empty()) return 0;
+    for (ds4_gpu_tensor *tensor : state.tensors) {
+        if (!tensor || !tensor->kv_meta) return 0;
+        cuda_kv_tensor_meta *meta = tensor->kv_meta;
+        if (require_marked && meta->marked_generation != generation) return 0;
+        if (!require_marked && meta->generation != generation) return 0;
+        if (meta->live_count > 2) return 0;
+        for (uint32_t i = 0; i < meta->live_count; i++) {
+            if (meta->live[i].offset > tensor->bytes ||
+                meta->live[i].bytes >
+                    tensor->bytes - meta->live[i].offset) {
+                return 0;
+            }
+        }
+        const int phase = meta->phase.load(std::memory_order_acquire);
+        if (phase == CUDA_KV_TENSOR_ERROR ||
+            phase == CUDA_KV_TENSOR_MIGRATING_TO_HOST ||
+            phase == CUDA_KV_TENSOR_RESTORING) {
+            return 0;
+        }
+    }
+    return 1;
+}
