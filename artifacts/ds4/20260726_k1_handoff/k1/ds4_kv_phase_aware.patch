+    std::lock_guard<std::mutex> lock(g_kv_staged_ring_mutex);
+    cuda_kv_staged_registry &state = g_kv_staged_registry;
+    if (!state.host_resident) {
+        fprintf(stderr,
+                "ds4: [kv-phase] event=acquire action=device "
+                "session=%llu generation=%llu tokens=%u suffix=%u\n",
+                (unsigned long long)session_generation,
+                (unsigned long long)checkpoint_generation,
+                checkpoint_tokens,
+                suffix_tokens);
+        return 1;
+    }
+
+    const char *reason = NULL;
+    if (g_kv_staged_sticky_off.load(std::memory_order_acquire)) {
+        reason = "sticky-off";
+    } else if (!exact_prefix) {
+        reason = "prefix-mismatch";
+    } else if (!suffix_ring_supported) {
+        reason = "unsupported-suffix-prefill";
+    } else if (state.session_generation != session_generation) {
+        reason = "session-generation-mismatch";
+    } else if (state.checkpoint_generation != checkpoint_generation) {
+        reason = "checkpoint-generation-mismatch";
+    } else if (state.checkpoint_fingerprint != checkpoint_fingerprint) {
+        reason = "checkpoint-fingerprint-mismatch";
+    } else if (state.checkpoint_tokens != checkpoint_tokens) {
+        reason = "checkpoint-token-count-mismatch";
+    } else if (!cuda_kv_staged_validate_registry_locked(
+                   state.checkpoint_generation, 0)) {
+        reason = "invalid-live-frontier";
+    }
+
+    if (!reason) {
+        state.retain_hits++;
+        fprintf(stderr,
+                "ds4: [kv-phase] event=acquire action=reuse-staged "
+                "state=HOST_STAGED session=%llu generation=%llu "
+                "tokens=%u suffix=%u fallback=none\n",
+                (unsigned long long)session_generation,
+                (unsigned long long)checkpoint_generation,
+                checkpoint_tokens,
+                suffix_tokens);
+        return 1;
+    }
+
+    state.exact_fallbacks++;
+    fprintf(stderr,
+            "ds4: [kv-phase] event=fallback action=full-live-restore "
+            "reason=%s session=%llu expected_session=%llu "
+            "generation=%llu expected_generation=%llu suffix=%u\n",
+            reason,
+            (unsigned long long)session_generation,
+            (unsigned long long)state.session_generation,
+            (unsigned long long)checkpoint_generation,
