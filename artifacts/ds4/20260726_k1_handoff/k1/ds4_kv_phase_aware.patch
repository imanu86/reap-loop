diff --git a/tests/test_kv_phase_lifecycle_static.ps1 b/tests/test_kv_phase_lifecycle_static.ps1
new file mode 100644
index 0000000..6ea6f2f
--- /dev/null
+++ b/tests/test_kv_phase_lifecycle_static.ps1
@@ -0,0 +1,140 @@
+param(
+    [string]$SourceRoot = (Split-Path -Parent $PSScriptRoot)
+)
+
+$ErrorActionPreference = 'Stop'
+
+function Assert-True {
+    param([bool]$Condition, [string]$Message)
+    if (-not $Condition) {
+        throw "KV phase lifecycle static contract failed: $Message"
+    }
+}
+
+function Assert-Contains {
+    param([string]$Text, [string]$Needle, [string]$Message)
+    Assert-True ($Text.Contains($Needle)) $Message
+}
+
+$corePath = Join-Path $SourceRoot 'ds4.c'
+$cudaPath = Join-Path $SourceRoot 'ds4_cuda.cu'
+$headerPath = Join-Path $SourceRoot 'ds4_gpu.h'
+
+$core = [IO.File]::ReadAllText($corePath)
+$cuda = [IO.File]::ReadAllText($cudaPath)
+$header = [IO.File]::ReadAllText($headerPath)
+
+# The candidate is a separate strict opt-in. Exact string comparison makes
+# unset, "0", and malformed values use the frozen P1 request-end behavior.
+Assert-Contains $core 'DS4_CUDA_KV_PERSISTENT_STAGED' 'missing session-side opt-in'
+Assert-Contains $cuda 'strcmp(env, "1") == 0' 'opt-in is not exact-value gated'
+Assert-Contains $cuda 'DS4_CUDA_KV_STAGED_RING-not-enabled' 'ring dependency is not explicit'
+Assert-Contains $core 'DS4_CUDA_KV_PHASE_VALIDATE' 'exact validation opt-in is missing'
+
+# Per-tensor state and generation must be explicit and acquire/release
+# published. The state list intentionally distinguishes motion from authority.
+foreach ($state in @(
+    'CUDA_KV_TENSOR_DEVICE',
+    'CUDA_KV_TENSOR_MIGRATING_TO_HOST',
+    'CUDA_KV_TENSOR_HOST_STAGED',
+    'CUDA_KV_TENSOR_RESTORING',
+    'CUDA_KV_TENSOR_DIRTY',
+    'CUDA_KV_TENSOR_ERROR'
+)) {
+    Assert-Contains $cuda $state "missing tensor state $state"
+}
+Assert-Contains $cuda 'std::memory_order_release' 'state publication lacks release ordering'
+Assert-Contains $cuda 'std::memory_order_acquire' 'state acquisition lacks acquire ordering'
+Assert-Contains $cuda 'marked_generation' 'frontier lacks per-tensor generation'
+Assert-Contains $cuda 'checkpoint_fingerprint' 'checkpoint fingerprint is absent'
+Assert-Contains $cuda 'checkpoint-token-count-mismatch' 'token frontier mismatch is not fail-closed'
+
+# The graph has exactly three KV allocation families. Runtime expands these
+# loops to 43 raw + 41 attention compressed + 21 indexer compressed = 105.
+$kvAllocCalls = [regex]::Matches(
+    $core,
+    'ds4_gpu_tensor_alloc_kv_cache\s*\('
+).Count
+Assert-True ($kvAllocCalls -eq 3) "expected 3 KV allocation families, found $kvAllocCalls"
+
+# Raw state is a circular live window (at most two spans); compressed and
+# indexer state are contiguous prefixes based on the runtime row frontiers.
+Assert-Contains $core 'session_raw_live_rows' 'raw live-row authority is not reused'
+Assert-Contains $core 'raw_live - raw_rows0' 'raw wrap is not represented by a second span'
+Assert-Contains $core 'g->layer_n_comp[il] * raw_row_bytes' 'attention live frontier uses capacity'
+Assert-Contains $core 'g->layer_n_index_comp[il] * index_row_bytes' 'indexer live frontier uses capacity'
+Assert-Contains $cuda 'cuda_kv_meta_contains' 'staged reads do not check live spans'
+Assert-Contains $cuda 'outside live frontier' 'invalid live-range reads are not observable'
+
+# Persistent migration and exact restore copy only published live ranges,
+# preserve the original allocation kind, and reject transitions with a live
+# non-owning view.
+Assert-Contains $cuda 'staged KV selective migration D2H' 'selective migration is missing'
+Assert-Contains $cuda 'staged KV selective restore H2D' 'selective restore is missing'
+Assert-Contains $cuda 'meta->backing_managed' 'restore does not preserve allocation kind'
+Assert-Contains $cuda 'view_count' 'KV view lifetime is not tracked'
+Assert-Contains $cuda 'migration blocked by live KV view' 'migration view guard is missing'
+Assert-Contains $cuda 'cuda_kv_staged_no_live_views_locked("restore")' 'restore view guard is missing'
+
+# The lifecycle acquire must run before the exact-prefix branch can enter
+# resumed batched prefill and create transient cache views. Unsupported
+# multi-token suffixes therefore restore at the boundary, not in a leaf.
+$syncStart = $core.IndexOf('int ds4_session_sync(')
+$acquire = $core.IndexOf('ds4_gpu_kv_staged_request_begin(', $syncStart)
+$prefixBranch = $core.IndexOf('if (exact_checkpoint_prefix)', $syncStart)
+$batchedPrefill = $core.IndexOf('metal_graph_prefill_chunked_range(', $syncStart)
+Assert-True ($syncStart -ge 0 -and $acquire -gt $syncStart) 'session acquire is absent'
+Assert-True ($acquire -lt $prefixBranch) 'acquire occurs after prefix branch'
+Assert-True ($acquire -lt $batchedPrefill) 'acquire occurs after batched suffix entry'
+Assert-Contains $cuda 'unsupported-suffix-prefill' 'planned batched-suffix fallback is missing'
+Assert-True (
+    $core.IndexOf('ds4_gpu_dynamic_arena_request_begin()', $syncStart) -lt
+    $acquire
+) 'frozen P0.1 request-boundary quiesce ordering changed'
+
+# Request end retains only after an exact frontier commit. Every other lineage
+# change has a named restore/invalidate path and every fallback is logged.
+Assert-Contains $core 'ds4_gpu_kv_staged_request_commit' 'request-end staged commit is missing'
+Assert-Contains $cuda 'event=release action=retain-staged' 'retain transition telemetry is missing'
+Assert-Contains $cuda 'request_end_restore_count=0 request_end_restore_bytes=0' 'round-trip counters are missing'
+foreach ($reason in @(
+    'prefix-mismatch',
+    'session-generation-mismatch',
+    'checkpoint-generation-mismatch',
+    'unsupported-suffix-prefill',
+    'payload-load',
+    'session-invalidated',
+    'session-rewind',
+    'session-free'
+)) {
+    Assert-True (
+        $core.Contains($reason) -or $cuda.Contains($reason)
+    ) "missing fallback/invalidation reason $reason"
+}
+Assert-Contains $cuda 'event=fallback action=full-live-restore' 'fallback can be silent'
+
+# Validation-only checksums run at the request boundary, hash the logits stream
+# already present on the host, and read only the same exact live KV ranges.
+Assert-Contains $core 'logits_fnv1a64=%016llx' 'exact logits checksum telemetry is missing'
+Assert-Contains $core 'kv_live_fnv1a64=%016llx' 'exact live-KV checksum telemetry is missing'
+Assert-Contains $core 'scope=live-ranges-only' 'KV checksum scope is ambiguous'
+Assert-Contains $core 'ds4_session_hash_cuda_kv_range' 'range-scoped KV checksum helper is missing'
+Assert-Contains $core 's->kv_validation_logits_samples++' 'logits samples are not accumulated'
+
+# Property check for the exact raw-span formula used by ds4.c.
+foreach ($case in @(
+    @{ Tokens = 1; Window = 128; Cap = 378; Expected = 1 },
+    @{ Tokens = 127; Window = 128; Cap = 378; Expected = 127 },
+    @{ Tokens = 128; Window = 128; Cap = 378; Expected = 128 },
+    @{ Tokens = 379; Window = 128; Cap = 378; Expected = 128 },
+    @{ Tokens = 150000; Window = 8192; Cap = 8192; Expected = 8192 }
+)) {
+    $live = [Math]::Min($case.Tokens, [Math]::Min($case.Window, $case.Cap))
+    $start = ($case.Tokens - $live) % $case.Cap
+    $rows0 = [Math]::Min($live, $case.Cap - $start)
+    $rows1 = $live - $rows0
+    Assert-True (($rows0 + $rows1) -eq $case.Expected) "raw span coverage failed for $($case.Tokens)"
+    Assert-True ($rows0 -ge 0 -and $rows1 -ge 0) "negative raw span for $($case.Tokens)"
+}
+
+Write-Output 'PASS test_kv_phase_lifecycle_static'
