+static bool ds4_session_cuda_kv_validation_requested(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *value = getenv("DS4_CUDA_KV_PHASE_VALIDATE");
+        cached = value && strcmp(value, "1") == 0 ? 1 : 0;
+    }
+    return cached != 0;
+}
+
+static uint64_t ds4_fnv1a64_update(
+        uint64_t hash, const void *data, uint64_t bytes) {
+    const uint8_t *cursor = (const uint8_t *)data;
+    for (uint64_t i = 0; i < bytes; i++) {
+        hash ^= cursor[i];
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
