+static uint64_t ds4_session_checkpoint_fingerprint(const ds4_session *s) {
+    uint64_t hash = UINT64_C(14695981039346656037);
+    if (!s || !s->checkpoint_valid) return hash;
+    for (int i = 0; i < s->checkpoint.len; i++) {
+        const uint32_t token = (uint32_t)s->checkpoint.v[i];
+        for (uint32_t shift = 0; shift < 32; shift += 8) {
+            hash ^= (uint8_t)(token >> shift);
+            hash *= UINT64_C(1099511628211);
+        }
+    }
+    hash ^= (uint32_t)s->checkpoint.len;
+    hash *= UINT64_C(1099511628211);
+    return hash;
+}
