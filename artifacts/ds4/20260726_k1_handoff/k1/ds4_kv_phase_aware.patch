+static bool ds4_session_hash_cuda_kv_range(
+        const ds4_gpu_tensor *tensor,
+        uint64_t offset,
+        uint64_t bytes,
+        uint64_t *hash,
+        uint8_t *scratch,
+        uint64_t scratch_bytes) {
+    if (!tensor || !hash || !scratch || scratch_bytes == 0 ||
+        offset > ds4_gpu_tensor_bytes(tensor) ||
+        bytes > ds4_gpu_tensor_bytes(tensor) - offset) {
+        return false;
+    }
+    const uint64_t descriptor[2] = {offset, bytes};
+    *hash = ds4_fnv1a64_update(
+        *hash, descriptor, sizeof(descriptor));
+    uint64_t done = 0;
+    while (done < bytes) {
+        const uint64_t chunk = bytes - done < scratch_bytes
+            ? bytes - done : scratch_bytes;
+        if (!ds4_gpu_tensor_read(
+                tensor, offset + done, scratch, chunk)) {
+            return false;
+        }
+        *hash = ds4_fnv1a64_update(*hash, scratch, chunk);
+        done += chunk;
+    }
+    return true;
+}
+
+static bool ds4_session_cuda_kv_live_checksum(
+        ds4_session *s, uint64_t *checksum) {
+    if (!s || !checksum || !s->checkpoint_valid ||
+        s->checkpoint.len <= 0) {
+        return false;
+    }
+    const uint64_t scratch_bytes = UINT64_C(1) << 20;
+    uint8_t *scratch = (uint8_t *)malloc((size_t)scratch_bytes);
+    if (!scratch) return false;
+
+    ds4_gpu_graph *g = &s->graph;
+    uint64_t hash = UINT64_C(14695981039346656037);
+    const uint64_t raw_row_bytes =
+        (uint64_t)DS4_N_HEAD_DIM * sizeof(float);
+    const uint32_t raw_live =
+        session_raw_live_rows(g, (uint32_t)s->checkpoint.len);
+    const uint32_t raw_first =
+        (uint32_t)s->checkpoint.len - raw_live;
+    const uint32_t raw_start = raw_first % g->raw_cap;
+    const uint32_t raw_rows0 =
+        raw_live < g->raw_cap - raw_start
+            ? raw_live : g->raw_cap - raw_start;
+    const uint32_t raw_rows1 = raw_live - raw_rows0;
+    bool ok = true;
+
+    for (uint32_t il = 0; ok && il < DS4_N_LAYER; il++) {
+        const uint64_t raw_tag[2] = {il, 0};
+        hash = ds4_fnv1a64_update(hash, raw_tag, sizeof(raw_tag));
+        ok = ds4_session_hash_cuda_kv_range(
+            g->layer_raw_cache[il],
+            (uint64_t)raw_start * raw_row_bytes,
+            (uint64_t)raw_rows0 * raw_row_bytes,
+            &hash, scratch, scratch_bytes);
+        if (ok && raw_rows1 != 0) {
+            ok = ds4_session_hash_cuda_kv_range(
+                g->layer_raw_cache[il],
+                0,
+                (uint64_t)raw_rows1 * raw_row_bytes,
+                &hash, scratch, scratch_bytes);
+        }
+
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        if (!ok || ratio == 0) continue;
+        const uint64_t comp_tag[2] = {il, 1};
+        hash = ds4_fnv1a64_update(hash, comp_tag, sizeof(comp_tag));
+        ok = ds4_session_hash_cuda_kv_range(
+            g->layer_attn_comp_cache[il],
+            0,
+            (uint64_t)g->layer_n_comp[il] * raw_row_bytes,
+            &hash, scratch, scratch_bytes);
+        if (ok && ratio == 4) {
+            const uint64_t index_tag[2] = {il, 2};
+            const uint64_t index_row_bytes =
+                (uint64_t)DS4_N_INDEXER_HEAD_DIM * sizeof(float);
+            hash = ds4_fnv1a64_update(
+                hash, index_tag, sizeof(index_tag));
+            ok = ds4_session_hash_cuda_kv_range(
+                g->layer_index_comp_cache[il],
+                0,
+                (uint64_t)g->layer_n_index_comp[il] *
+                    index_row_bytes,
+                &hash, scratch, scratch_bytes);
+        }
+    }
+    free(scratch);
+    if (ok) *checksum = hash;
+    return ok;
+}
