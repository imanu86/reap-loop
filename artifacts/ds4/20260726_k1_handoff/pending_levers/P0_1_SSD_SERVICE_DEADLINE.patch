diff --git a/wt-hot-reserve/tests/test_p0_1_ssd_rotator_service_deadline_static.ps1 b/wt-hot-reserve/tests/test_p0_1_ssd_rotator_service_deadline_static.ps1
new file mode 100644
index 0000000..a750525
--- /dev/null
+++ b/wt-hot-reserve/tests/test_p0_1_ssd_rotator_service_deadline_static.ps1
@@ -0,0 +1,139 @@
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version 2.0
+
+$sourceRoot = Split-Path -Parent (Split-Path -Parent $MyInvocation.MyCommand.Path)
+$workspace = Split-Path -Parent $sourceRoot
+$runtimeRoot = Join-Path $workspace 'runtime_p0p1'
+$source = [System.IO.File]::ReadAllText(
+    (Join-Path $sourceRoot 'ds4_cuda.cu'))
+$runner = [System.IO.File]::ReadAllText(
+    (Join-Path $runtimeRoot 'run_two_turn_lifecycle.ps1'))
+$manifest = [System.IO.File]::ReadAllText(
+    (Join-Path $runtimeRoot 'manifest_47.env'))
+
+function Assert-True([bool]$Condition, [string]$Message) {
+    if (-not $Condition) {
+        throw "P0.1 SSD service-deadline contract failed: $Message"
+    }
+}
+
+function Assert-Contains(
+        [string]$Text, [string]$Needle, [string]$Message) {
+    Assert-True ($Text.Contains($Needle)) $Message
+}
+
+function Slice-Between(
+        [string]$Text, [string]$Start, [string]$End) {
+    $begin = $Text.IndexOf($Start, [StringComparison]::Ordinal)
+    if ($begin -lt 0) { throw "missing slice start: $Start" }
+    $finish = $Text.IndexOf(
+        $End, $begin + $Start.Length, [StringComparison]::Ordinal)
+    if ($finish -lt 0) { throw "missing slice end: $End" }
+    return $Text.Substring($begin, $finish - $begin)
+}
+
+$timing = Slice-Between $source `
+    'static cuda_q1_0_ssd_wrap_service_timing' `
+    'static cuda_q1_0_ssd_wrap_read_result cuda_q1_0_ssd_wrap_read_job('
+$worker = Slice-Between $source `
+    'static void *cuda_q1_0_ssd_wrap_worker(void *) {' `
+    'static int cuda_q1_0_ssd_wrap_init(void) {'
+$poll = Slice-Between $source `
+    'static int cuda_q1_0_ssd_wrap_poll_internal(int force) {' `
+    'static int cuda_q1_0_ssd_wrap_poll(void) {'
+$submit = Slice-Between $source `
+    'static int cuda_q1_0_ssd_wrap_submit(' `
+    'static void cuda_g73_open_maybe_schedule_rotation('
+$finish = Slice-Between $source `
+    'static int cuda_q1_0_ssd_wrap_finish_one(' `
+    'static void *cuda_q1_0_ssd_wrap_selftest_finish_one('
+
+# 1. An old queued_at cannot expire a freshly acquired G73 service budget.
+Assert-Contains $timing `
+    'timing.service_deadline = io_started + timing.service_budget_seconds;' `
+    'deadline is not based on io_started'
+Assert-Contains $timing 'io_started - job.queued_at' `
+    'queue age is not independently measured'
+Assert-True (-not $timing.Contains(
+    'job.queued_at + timing.service_budget_seconds')) `
+    'queued_at still anchors the service deadline'
+Assert-Contains $source `
+    'cuda_deadline_remaining_ms(aged_advisory_timing.io_deadline) > 0u' `
+    'selftest does not prove that an aged G73 job can enter pread'
+
+# 2. Every selected job acquires timing inside the per-job service loop.
+Assert-Contains $worker `
+    'const double io_started = cuda_wall_sec();' `
+    'worker lacks per-job service acquisition'
+Assert-Contains $worker `
+    'cuda_q1_0_ssd_wrap_service_timing_for_job(' `
+    'worker does not calculate per-job timing'
+Assert-Contains $source `
+    '"service_deadline=%s per_job_service_budget=%s "' `
+    'selftest does not cover independent jobs in one wave'
+
+# 3. A real service timeout remains explicit, advisory, and degraded.
+Assert-Contains $worker `
+    'cuda_q1_0_ssd_wrap_io_status_name(' `
+    'I/O status is absent from failure telemetry'
+Assert-Contains $worker `
+    '"queue_age_ms=%.9g service_budget_ms=%.9g "' `
+    'event/wave queue and service telemetry is absent'
+Assert-Contains $finish 'return ok || advisory_io_failure;' `
+    'advisory timeout still poisons poll/submit'
+Assert-Contains $source `
+    '(state.advisory_failures ? "degraded" : "complete")' `
+    'advisory timeout is hidden from the final summary'
+
+# 4. Queue aging and admission pressure remain outside the I/O deadline.
+Assert-Contains $poll 'state.max_age_calls' `
+    'logical queue aging is missing'
+Assert-True (-not $poll.Contains('cuda_q1_0_ssd_wrap_read_job')) `
+    'queue aging invokes the SSD read path'
+Assert-Contains $submit 'state.backpressure++;' `
+    'admission pressure telemetry is missing'
+Assert-Contains $submit 'return 3;' `
+    'admission pressure is not a distinct submit result'
+
+# 5. Non-G73 remains request-bounded and structurally fail-closed.
+Assert-Contains $timing '!job.g73_open_rotation &&' `
+    'G73/non-G73 deadline split is missing'
+Assert-Contains $timing 'job.request.absolute_deadline > 0.0' `
+    'non-G73 request deadline is missing'
+Assert-Contains $finish `
+    'cuda_q1_0_ssd_wrap_fail_and_release_all_locked(' `
+    'non-advisory failure is no longer terminal'
+Assert-Contains $source `
+    '"queue_aging=separate non_g73_deadline=%s "' `
+    'selftest does not cover the request-bounded non-G73 deadline'
+
+# 6. Single counting, clean release, and later rotation remain covered.
+Assert-Contains $source 'if (!job.failure_counted) {' `
+    'terminal teardown can double-count a worker failure'
+Assert-Contains $source `
+    'state.failures == failures_before + 1u' `
+    'selftest does not require single failure accounting'
+Assert-Contains $source `
+    'advisory_followup_ok ? "subsequent-promoted" : "failed"' `
+    'selftest does not require a later successful rotation'
+Assert-Contains $source `
+    'g_moe_tiering.entries[3u].state == CUDA_MOE_TIER_SSD_COLD' `
+    'failed advisory route can leave SSD-cold serving'
+
+# 7. Benchmark health remains fail-closed for advisory/degraded telemetry.
+Assert-Contains $runner '$result -eq ''complete''' `
+    'runner accepts result=degraded'
+Assert-Contains $runner '$fields.advisory_failures -eq 0' `
+    'runner accepts advisory failures'
+Assert-Contains $runner '$fields.advisory_degraded -eq 0' `
