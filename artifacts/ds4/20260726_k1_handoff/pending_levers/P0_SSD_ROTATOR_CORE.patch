+++ b/wt-hot-reserve/tests/test_p0_ssd_rotator_advisory_static.ps1
@@ -0,0 +1,111 @@
+$ErrorActionPreference = 'Stop'
+
+$root = Split-Path -Parent (Split-Path -Parent $MyInvocation.MyCommand.Path)
+$source = [System.IO.File]::ReadAllText((Join-Path $root 'ds4_cuda.cu'))
+$runnerPath = Join-Path (
+    Split-Path -Parent $root) 'runtime_p0p1\run_two_turn_lifecycle.ps1'
+$runner = [System.IO.File]::ReadAllText($runnerPath)
+
+function Assert-True([bool]$Condition, [string]$Message) {
+    if (-not $Condition) {
+        throw "P0 SSD rotator advisory contract failed: $Message"
+    }
+}
+
+function Assert-Contains(
+        [string]$Text, [string]$Needle, [string]$Message) {
+    Assert-True ($Text.Contains($Needle)) $Message
+}
+
+function Slice-Between(
+        [string]$Text, [string]$Start, [string]$End) {
+    $begin = $Text.IndexOf($Start, [StringComparison]::Ordinal)
+    if ($begin -lt 0) { throw "missing slice start: $Start" }
+    $finish = $Text.IndexOf(
+        $End, $begin + $Start.Length, [StringComparison]::Ordinal)
+    if ($finish -lt 0) { throw "missing slice end: $End" }
+    return $Text.Substring($begin, $finish - $begin)
+}
+
+$worker = Slice-Between $source `
+    'static void *cuda_q1_0_ssd_wrap_worker(void *) {' `
+    'static int cuda_q1_0_ssd_wrap_init(void) {'
+Assert-Contains $worker 'const double rotator_deadline =' `
+    'worker lacks a rotator-local deadline'
+Assert-Contains $worker '!local.g73_open_rotation &&' `
+    'G73 advisory reads still inherit the serving deadline'
+Assert-Contains $worker 'local.request.absolute_deadline > 0.0' `
+    'non-G73 promotion lost its fail-closed request deadline'
+Assert-Contains $worker 'job->failure_counted = 1u;' `
+    'worker failure is not marked as already counted'
+Assert-Contains $worker 'state.advisory_failures++;' `
+    'advisory failure telemetry is missing'
+Assert-Contains $worker '"rotator-local"' `
+    'failure telemetry does not identify the deadline domain'
+Assert-Contains $worker 'job->layer, job->expert' `
+    'failure telemetry does not identify the failed route'
+
+$finishOne = Slice-Between $source `
+    'static int cuda_q1_0_ssd_wrap_finish_one(' `
+    'static int cuda_q1_0_ssd_wrap_poll_internal('
+Assert-Contains $finishOne 'const int advisory_io_failure =' `
+    'finish path does not distinguish advisory I/O from structural failure'
+Assert-Contains $finishOne 'state.advisory_releases++;' `
+    'advisory release telemetry is missing'
+Assert-Contains $finishOne `
+    'cuda_q1_0_ssd_wrap_job_release_locked(&state.jobs[index]);' `
+    'advisory failure does not release its job-local ownership'
+Assert-Contains $finishOne 'return ok || advisory_io_failure;' `
+    'advisory terminal still poisons poll/submit'
+Assert-Contains $finishOne `
+    'cuda_q1_0_ssd_wrap_fail_and_release_all_locked(' `
+    'structural and non-G73 errors are no longer terminal'
+
+$releaseAll = Slice-Between $source `
+    'static void cuda_q1_0_ssd_wrap_fail_and_release_all_locked(' `
+    'static void cuda_q1_0_ssd_wrap_disable('
+Assert-Contains $releaseAll 'if (!job.failure_counted) {' `
+    'terminal teardown can double-count an existing I/O failure'
+Assert-Contains $releaseAll 'state.failed = 1;' `
+    'structural teardown no longer latches failed'
+Assert-Contains $releaseAll 'state.stop = 1;' `
+    'structural teardown no longer stops the worker'
+
+Assert-Contains $source `
+    '(state.advisory_failures ? "degraded" : "complete")' `
+    'final telemetry hides an advisory-degraded rotator'
+Assert-Contains $source 'advisory_failures=%llu' `
+    'final telemetry lacks advisory failure count'
+Assert-Contains $source 'advisory_releases=%llu' `
+    'final telemetry lacks job-local release count'
+Assert-Contains $source 'advisory_failure=%s advisory_followup=%s' `
+    'self-test does not report advisory failure and subsequent rotation'
+Assert-Contains $source '"job-local-clean"' `
+    'self-test does not assert clean advisory teardown'
+Assert-Contains $source '"subsequent-promoted"' `
+    'self-test does not assert a rotation after advisory failure'
+Assert-Contains $source '"structural_failure=terminal "' `
+    'self-test does not retain a terminal structural error assertion'
+Assert-Contains $source `
+    'g_moe_tiering.entries[3u].state == CUDA_MOE_TIER_SSD_COLD' `
+    'self-test does not prove the failed route remains SSD-cold'
+Assert-Contains $source `
+    'state.failures == failures_before + 1u' `
+    'self-test does not prove single failure accounting'
+
+Assert-Contains $runner 'function Get-Q1SsdWrapGate {' `
+    'runner lacks a dedicated rotator gate'
+Assert-Contains $runner '$rotatorGate.gate_pass -and' `
+    'overall gate does not require rotator health'
+Assert-Contains $runner '$fields.advisory_failures -eq 0' `
+    'runner accepts advisory failures'
+Assert-Contains $runner '$fields.advisory_degraded -eq 0' `
+    'runner accepts degraded rotator state'
+Assert-Contains $runner '$fields.dropped -eq 0' `
+    'runner accepts dropped rotator work'
+Assert-Contains $runner '$summaryMatches.Count -eq 1' `
+    'runner does not fail closed on missing/duplicate summary'
+Assert-Contains $runner 'serving_exact_gate_pass=' `
+    'runner does not report exact-serving correctness separately'
+
+Write-Output 'test_p0_ssd_rotator_advisory_static.ps1: PASS'
