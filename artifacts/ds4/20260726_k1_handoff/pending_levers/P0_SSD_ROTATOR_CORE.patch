+function Get-Q1SsdWrapGate {
+    param([string]$LogText)
+
+    $summaryMatches = [regex]::Matches(
+        $LogText,
+        '(?m)^ds4: \[q1-0-ssd-wrap\] ' +
+        'result=(complete|degraded|failed) requested=[^\r\n]*(?=\r?$)')
+    $summary = if ($summaryMatches.Count -eq 1) {
+        $summaryMatches[0].Value
+    } else {
+        ''
+    }
+    $result = if ($summary -match 'result=(complete|degraded|failed)') {
+        $matches[1]
+    } else {
+        'missing'
+    }
+    $fields = [ordered]@{}
+    foreach ($name in @(
+            'requested', 'attempts', 'successes', 'failures',
+            'advisory_failures', 'advisory_releases',
+            'advisory_degraded', 'structural_rejects', 'stale', 'dropped',
+            'ram_ready', 'pinned_ready', 'pageable_ready')) {
+        $fields[$name] = -1L
+        if ($summary -match "(?:^|\s)$name=(\d+)") {
+            $fields[$name] = [Int64]$matches[1]
+        }
+    }
+    $terminalMarkerCount = [regex]::Matches(
+        $LogText,
+        '(?m)^ds4: \[q1-0-ssd-wrap(?:-wave|-io)?\]' +
+        '[^\r\n]*(?:result=(?:failed|degraded)|worker detached|' +
+        'commit deadline expired|safe-leaked|tier reset deferred|' +
+        'retained tier entries permanently)').Count
+    $accountingPass =
+        $fields.requested -eq $fields.attempts -and
+        $fields.attempts -eq (
+            $fields.successes + $fields.failures + $fields.dropped) -and
+        $fields.ram_ready -eq $fields.successes -and
+        ($fields.pinned_ready + $fields.pageable_ready) -eq
+            $fields.successes -and
+        $fields.advisory_releases -eq $fields.advisory_failures
+    $gatePass =
+        $summaryMatches.Count -eq 1 -and
+        $result -eq 'complete' -and
+        $fields.attempts -gt 0 -and
+        $fields.failures -eq 0 -and
+        $fields.advisory_failures -eq 0 -and
+        $fields.advisory_releases -eq 0 -and
+        $fields.advisory_degraded -eq 0 -and
+        $fields.structural_rejects -eq 0 -and
+        $fields.stale -eq 0 -and
+        $fields.dropped -eq 0 -and
+        $terminalMarkerCount -eq 0 -and
+        $accountingPass
+
+    return [pscustomobject]@{
+        gate_pass = $gatePass
+        summary_count = $summaryMatches.Count
+        result = $result
+        terminal_marker_count = $terminalMarkerCount
+        accounting_pass = $accountingPass
+        requested = $fields.requested
+        attempts = $fields.attempts
+        successes = $fields.successes
+        failures = $fields.failures
+        advisory_failures = $fields.advisory_failures
+        advisory_releases = $fields.advisory_releases
+        advisory_degraded = $fields.advisory_degraded
+        structural_rejects = $fields.structural_rejects
+        stale = $fields.stale
+        dropped = $fields.dropped
+    }
+}
