diff --git a/runtime_p0p1/test_p0_ssd_rotator_runner_gate.ps1 b/runtime_p0p1/test_p0_ssd_rotator_runner_gate.ps1
new file mode 100644
index 0000000..4f93cb2
--- /dev/null
+++ b/runtime_p0p1/test_p0_ssd_rotator_runner_gate.ps1
@@ -0,0 +1,68 @@
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version 2.0
+
+$runnerPath = Join-Path $PSScriptRoot 'run_two_turn_lifecycle.ps1'
+$runner = [System.IO.File]::ReadAllText($runnerPath)
+$start = $runner.IndexOf(
+    'function Get-Q1SsdWrapGate {', [StringComparison]::Ordinal)
+$end = $runner.IndexOf(
+    'function Get-LogLineCount {', $start, [StringComparison]::Ordinal)
+if ($start -lt 0 -or $end -le $start) {
+    throw 'unable to isolate Get-Q1SsdWrapGate from runner'
+}
+Invoke-Expression $runner.Substring($start, $end - $start)
+
+function Assert-True([bool]$Condition, [string]$Message) {
+    if (-not $Condition) {
+        throw "P0 SSD rotator runner fixture failed: $Message"
+    }
+}
+
+$valid = @'
+ds4: [q1-0-ssd-wrap] result=complete requested=2 deduplicated=0 backpressure=0 attempts=2 successes=2 failures=0 advisory_failures=0 advisory_releases=0 advisory_degraded=0 structural_rejects=0 bytes_requested=14155776 bytes_read=14155776 bytes_useful=14155776 ranges_requested=6 ranges_read=6 coalesced_ranges=0 max_queue_depth=1 waves_prefill=0 waves_decode=2 ram_ready=2 pinned_ready=2 pageable_ready=0 pinned_hits=10 pageable_hits=0 stale=0 dropped=0 host_copy_bytes=14155776 host_copy_seconds=0.001 h2d_waits=0 h2d_wait_seconds=0 pageable_paged_out_before_copy=0 first_use=0 wasted=0 service_seconds=0.003
+'@
+$gate = Get-Q1SsdWrapGate -LogText $valid
+Assert-True $gate.gate_pass 'healthy rotator summary was rejected'
+Assert-True $gate.accounting_pass 'healthy accounting was rejected'
+
+$advisory = @'
+ds4: [q1-0-ssd-wrap-io] result=degraded mode=advisory action=release-job-local wave_id=2 job=0 sequence=2 layer=7 expert=42 range=0 expected=1048576 actual=-1 errno=110 deadline=rotator-local service_seconds=0.05
+ds4: [q1-0-ssd-wrap] result=degraded requested=2 deduplicated=0 backpressure=0 attempts=2 successes=1 failures=1 advisory_failures=1 advisory_releases=1 advisory_degraded=1 structural_rejects=0 bytes_requested=14155776 bytes_read=7077888 bytes_useful=7077888 ranges_requested=6 ranges_read=3 coalesced_ranges=0 max_queue_depth=1 waves_prefill=0 waves_decode=2 ram_ready=1 pinned_ready=1 pageable_ready=0 pinned_hits=10 pageable_hits=0 stale=0 dropped=0 host_copy_bytes=7077888 host_copy_seconds=0.001 h2d_waits=0 h2d_wait_seconds=0 pageable_paged_out_before_copy=0 first_use=0 wasted=0 service_seconds=0.053
+'@
+$gate = Get-Q1SsdWrapGate -LogText $advisory
+Assert-True (-not $gate.gate_pass) 'advisory-degraded rotator passed'
+Assert-True $gate.accounting_pass `
+    'job-local advisory accounting should remain internally consistent'
+Assert-True ($gate.advisory_failures -eq 1 -and
+    $gate.advisory_releases -eq 1) `
+    'advisory failure/release telemetry was not preserved'
+
+$hiddenAdvisory = $valid.Replace(
+    'failures=0 advisory_failures=0 advisory_releases=0 advisory_degraded=0',
+    'failures=1 advisory_failures=1 advisory_releases=1 advisory_degraded=1'
+).Replace('attempts=2 successes=2', 'attempts=2 successes=1')
+$gate = Get-Q1SsdWrapGate -LogText $hiddenAdvisory
+Assert-True (-not $gate.gate_pass) `
+    'result=complete hid nonzero advisory telemetry'
+
+$doubleCount = $valid.Replace(
+    'attempts=2 successes=2 failures=0 advisory_failures=0 advisory_releases=0 advisory_degraded=0',
+    'attempts=2 successes=1 failures=2 advisory_failures=1 advisory_releases=1 advisory_degraded=1'
+).Replace('stale=0 dropped=0', 'stale=0 dropped=1')
+$gate = Get-Q1SsdWrapGate -LogText $doubleCount
+Assert-True (-not $gate.gate_pass) 'double-counted accounting passed'
+Assert-True (-not $gate.accounting_pass) `
+    'double-counted accounting invariant was not detected'
+
+$gate = Get-Q1SsdWrapGate -LogText ''
+Assert-True (-not $gate.gate_pass) 'missing summary passed'
+
+$gate = Get-Q1SsdWrapGate -LogText ($valid + "`n" + $valid)
+Assert-True (-not $gate.gate_pass) 'duplicate summary passed'
+
+$structural = $valid.Replace('result=complete', 'result=failed').Replace(
+    'structural_rejects=0', 'structural_rejects=1')
+$gate = Get-Q1SsdWrapGate -LogText $structural
+Assert-True (-not $gate.gate_pass) 'structural terminal passed'
+
+Write-Output 'test_p0_ssd_rotator_runner_gate.ps1: PASS'
